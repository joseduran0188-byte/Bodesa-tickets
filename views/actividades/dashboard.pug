
extends ../layout

mixin paginacion
    if totalActividades > 0
        .pagination-container(style='display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:12px; margin:20px 0; padding:15px; border:1px solid #ddd; border-radius:8px;')
            .pagination-info(style='font-size:14px;')
                | Mostrando
                strong= desdeRegistro
                |  a
                strong= hastaRegistro
                |  de
                strong= totalActividades
                |  actividades

            if totalPaginas > 1
                .pagination-controls(style='display:flex; flex-wrap:wrap; align-items:center; gap:6px;')
                    if tienePaginaAnterior
                        a.action-btn.action-view(
                            href=paginationUrl(1)
                            style='text-decoration:none;'
                        ) « Primera

                        a.action-btn.action-view(
                            href=paginationUrl(paginaAnterior)
                            style='text-decoration:none;'
                        ) ‹ Anterior
                    else
                        span.action-btn(style='opacity:.45;') « Primera
                        span.action-btn(style='opacity:.45;') ‹ Anterior

                    each numeroPagina in paginas
                        if numeroPagina === paginaActual
                            span.action-btn(
                                style='background:#2563eb; color:white; font-weight:bold;'
                            )= numeroPagina
                        else
                            a.action-btn.action-view(
                                href=paginationUrl(numeroPagina)
                                style='text-decoration:none;'
                            )= numeroPagina

                    if tienePaginaSiguiente
                        a.action-btn.action-view(
                            href=paginationUrl(paginaSiguiente)
                            style='text-decoration:none;'
                        ) Siguiente ›

                        a.action-btn.action-view(
                            href=paginationUrl(totalPaginas)
                            style='text-decoration:none;'
                        ) Última »
                    else
                        span.action-btn(style='opacity:.45;') Siguiente ›
                        span.action-btn(style='opacity:.45;') Última »

block content
    .container
        .page-header
            div
                h1 Capturas / Actividades
                p Bienvenido, #{user.full_name || user.email}

        // DIAGNÓSTICO
        .debug-dashboard(
            style='background:#fff3cd; color:#664d03; padding:15px; margin:15px 0; border:2px solid #ffca2c; border-radius:8px;'
        )
            h3(style='margin-top:0;') DIAGNÓSTICO DE PLANTILLA

            p
                strong Versión:
                |  DASHBOARD CATEGORÍAS, ETIQUETAS Y RESPONSABLES

            p
                strong Rol:
                |  #{user.role}

            p
                strong Registros recibidos:
                |  #{activities.length}

            p
                strong Página actual:
                |  #{paginaActual}

            p
                strong Total de páginas:
                |  #{totalPaginas}

            p
                strong Total de actividades:
                |  #{totalActividades}

        // RESUMEN GENERAL
        if resumenActividades
            .activity-summary(style='margin:25px 0;')
                h2(style='margin-bottom:15px;') Resumen general

                .summary-cards(
                    style='display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:12px; margin-bottom:25px;'
                )
                    .summary-card(
                        style='background:white; border:1px solid #ddd; border-radius:10px; padding:18px;'
                    )
                        p(style='margin:0; color:#666; font-size:13px;')
                            | Total de actividades

                        h2(style='margin:8px 0 0; font-size:28px;')
                            = resumenActividades.totalActividades.toLocaleString('es-MX')

                    .summary-card(
                        style='background:white; border:1px solid #ddd; border-radius:10px; padding:18px;'
                    )
                        p(style='margin:0; color:#666; font-size:13px;')
                            | Total de modelos

                        h2(style='margin:8px 0 0; font-size:28px;')
                            = resumenActividades.totalModelos.toLocaleString('es-MX')

                // RESUMEN POR ESTADO
                h2(style='margin:25px 0 15px;')
                    | Actividades por estado

                .status-summary(
                    style='display:grid; grid-template-columns:repeat(auto-fit,minmax(170px,1fr)); gap:12px;'
                )
                    each estado in resumenActividades.estados
                        .summary-card(
                            style='background:white; border:1px solid #ddd; border-radius:10px; padding:18px;'
                        )
                            p(style='margin:0; color:#666; font-size:13px;')
                                = estado.label

                            h2(style='margin:8px 0 0; font-size:26px;')
                                = estado.total.toLocaleString('es-MX')

                // RESUMEN POR CATEGORÍA
                h2(style='margin:25px 0 15px;')
                    | Actividades por categoría

                .category-summary(
                    style='display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:12px;'
                )
                    each categoria in resumenActividades.categorias
                        .category-card(
                            style='background:white; border:1px solid #ddd; border-radius:10px; padding:18px;'
                        )
                            h3(style='font-size:15px; margin:0 0 12px;')
                                = categoria.label

                            p(style='margin:5px 0; color:#555;')
                                strong= categoria.actividades.toLocaleString('es-MX')
                                |  actividades

                            p(style='margin:5px 0; color:#555;')
                                strong= categoria.modelos.toLocaleString('es-MX')
                                |  modelos

                // RESUMEN DE ETIQUETAS
                h2(style='margin:25px 0 15px;')
                    | Actividades por etiqueta operativa

                .tag-summary(
                    style='display:grid; grid-template-columns:repeat(auto-fit,minmax(170px,1fr)); gap:12px;'
                )
                    each etiqueta in resumenActividades.etiquetas
                        .summary-card(
                            style='background:white; border:1px solid #ddd; border-radius:10px; padding:18px;'
                        )
                            p(style='margin:0; color:#666; font-size:13px;')
                                = etiqueta.label

                            h2(style='margin:8px 0 0; font-size:26px;')
                                = etiqueta.actividades.toLocaleString('es-MX')

                            p(style='margin:5px 0 0; color:#777; font-size:12px;')
                                | actividades

        // FILTROS
        .activity-filters(
            style='background:white; border:1px solid #ddd; border-radius:10px; padding:18px; margin:25px 0;'
        )
            h2(style='margin-top:0; font-size:19px;')
                | Buscar actividades

            form(
                method='GET'
                action=dashboardUrl
                style='display:flex; flex-wrap:wrap; align-items:end; gap:12px;'
            )
                .filter-field(style='flex:1; min-width:220px;')
                    label(for='category-filter')
                        strong Categoría

                    select#category-filter(
                        name='category'
                        style='width:100%; padding:10px; border:1px solid #ccc; border-radius:6px;'
                    )
                        option(value='') Todas las categorías

                        each categoria in categoriasFiltro
                            option(
                                value=categoria.key
                                selected=(categoriaFiltro === categoria.key)
                            )= categoria.label

                .filter-field(style='flex:1; min-width:180px;')
                    label(for='tag-filter')
                        strong Etiqueta operativa

                    select#tag-filter(
                        name='tag'
                        style='width:100%; padding:10px; border:1px solid #ccc; border-radius:6px;'
                    )
                        option(value='') Todas las etiquetas

                        each etiqueta in etiquetasFiltro
                            option(
                                value=etiqueta.key
                                selected=(etiquetaFiltro === etiqueta.key)
                            )= etiqueta.label

                button.action-btn(
                    type='submit'
                    style='padding:10px 18px;'
                ) Filtrar

                a.action-btn.action-view(
                    href=dashboardUrl
                    style='text-decoration:none; padding:10px 18px;'
                ) Limpiar filtros

        // TABLA DE ACTIVIDADES
        if activities && activities.length
            +paginacion

            .tickets-table-wrapper
                table.tickets-table
                    thead
                        tr
                            th Título
                            th Remitente
                            th Categoría
                            th Etiquetas
                            th Tipo
                            th Cant.
                            th Prioridad
                            th Estado
                            th Responsable
                            th Acciones

                    tbody
                        each act in activities
                            tr
                                td.ticket-title= act.title

                                td= act.requester_name || '—'

                                td
                                    span.badge
                                        = categoriaLabel(act.catalog_category)

                                td
                                    if Array.isArray(act.operational_tags) && act.operational_tags.length
                                        div(style='display:flex; flex-wrap:wrap; gap:4px;')
                                            each tag in act.operational_tags
                                                span(
                                                    style='display:inline-block; padding:4px 8px; border-radius:12px; background:#e0e7ff; color:#3730a3; font-size:12px; font-weight:600;'
                                                )= tag
                                    else
                                        | —

                                td= act.activity_type || '—'

                                td= act.quantity !== null && act.quantity !== undefined ? act.quantity : '—'

                                td
                                    span(class='badge badge-' + (act.priority === 'urgente' ? 'alta' : act.priority))
                                        = act.priority

                                td
                                    span(class='badge badge-estado-' + act.status)
                                        = act.status

                                // RESPONSABLE CAPTURADO
                                td
                                    if act.current_responsible_name
                                        strong= act.current_responsible_name
                                    else if act.current_responsible && act.current_responsible.full_name
                                        = act.current_responsible.full_name
                                    else
                                        span(style='color:#888;') Sin asignar

                                td.actions
                                    a.action-btn.action-view(
                                        href=dashboardUrl + '/' + act.id
                                    ) Ver

                                    if user.role === 'admin' && act.status !== 'cancelada'
                                        a.action-btn.action-view(
                                            href=dashboardUrl + '/' + act.id + '#administracion'
                                        ) Editar

                                    // FORMULARIO PARA TOMAR ACTIVIDAD
                                    if act.status === 'disponible' || act.status === 'devuelta'
                                        form(
                                            method='POST'
                                            action=dashboardUrl + '/' + act.id + '/tomar'
                                            style='display:inline-flex; flex-direction:column; gap:6px; min-width:180px;'
                                        )
                                            input(
                                                type='text'
                                                name='responsible_name'
                                                placeholder='Nombre del responsable'
                                                required
                                                maxlength='120'
                                                autocomplete='off'
                                                style='padding:8px; border:1px solid #ccc; border-radius:6px; width:100%;'
                                            )

                                            button.action-btn(
                                                type='submit'
                                                style='width:100%;'
                                            ) Tomar actividad

                                    if act.status === 'en_proceso' && (act.current_responsible_id === user.id || user.role === 'admin')
                                        form(
                                            method='POST'
                                            action=dashboardUrl + '/' + act.id + '/terminar'
                                            style='display:inline-block'
                                            onsubmit="return confirm('¿Marcar esta actividad como terminada?');"
                                        )
                                            button.action-btn(type='submit') Terminar

                                        form(
                                            method='POST'
                                            action=dashboardUrl + '/' + act.id + '/liberar'
                                            style='display:inline-block'
                                            onsubmit="return confirm('¿Liberar esta actividad?');"
                                        )
                                            button.action-btn(type='submit') Liberar

                                    if act.status === 'pendiente_validacion' && user.role === 'admin'
                                        form(
                                            method='POST'
                                            action=dashboardUrl + '/' + act.id + '/validar'
                                            style='display:inline-block'
                                        )
                                            button.action-btn(type='submit') Validar

                                        form(
                                            method='POST'
                                            action=dashboardUrl + '/' + act.id + '/devolver'
                                            style='display:inline-block'
                                        )
                                            button.action-btn(type='submit') Devolver

                                    if act.status === 'validada' && user.role === 'admin'
                                        a.action-btn.action-view(
                                            href=dashboardUrl + '/' + act.id
                                        ) Desvalidar

                                    if act.status === 'cancelada' && user.role === 'admin'
                                        a.action-btn.action-view(
                                            href=dashboardUrl + '/' + act.id
                                        ) Reactivar

            +paginacion

        else
            .empty-state
                h3 No hay actividades

                if categoriaFiltro || etiquetaFiltro
                    p No se encontraron actividades con los filtros seleccionados.

                    a.action-btn.action-view(href=dashboardUrl)
                        | Limpiar filtros
                else
                    p Las capturas aparecerán aquí cuando se registren.
