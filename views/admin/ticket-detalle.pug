
extends ../layout

block content
    .container
        .page-header
            div
                h2= `Ticket #${ticket.id.substring(0, 8)}`
                p Bienvenido, #{user.full_name || user.email}
                p
                    strong Tipo de cuenta:
                    |  Administrador

            a.btn.btn-secondary(href=dashboardUrl)
                i.fa-solid.fa-arrow-left
                |  Volver al panel

        .detail-card
            h3 Información del ticket

            .detail-item
                strong Folio:
                span= ticket.id

            .detail-item
                strong Solicitante:
                span= ticket.nombre_solicitante || 'Sin nombre registrado'

                        .detail-item
                strong Fecha de creación:
            span= ticket.created_at ? new Date(ticket.created_at).toLocaleString('es-MX', { timeZone: 'America/Mexico_City', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true }) : '—'
            .detail-item
                strong Fecha de atención:
                span= ticket.created_at ? new Date(ticket.created_at).toLocaleString('es-MX', { timeZone: 'America/Mexico_City', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true }) : 'Pendiente'

            .detail-item
                strong Fecha de resolución:
                span= ticket.created_at ? new Date(ticket.created_at).toLocaleString('es-MX', { timeZone: 'America/Mexico_City', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true }) : 'Pendiente'

        .form-card
            h3 Gestión del ticket

            if editarTicket
                form(method="POST" action=dashboardUrl + '/' + ticket.id + '/actualizar')
                    .form-group
                        label(for="prioridad") Prioridad
                        select#prioridad(name="prioridad" required)
                            option(value="baja" selected=ticket.prioridad === 'baja') Baja
                            option(value="media" selected=ticket.prioridad === 'media') Media
                            option(value="alta" selected=ticket.prioridad === 'alta') Alta
                            option(value="urgente" selected=ticket.prioridad === 'urgente') Urgente

                    .form-group
                        label(for="estado") Estado
                        select#estado(name="estado" required)
                            option(value="pendiente" selected=ticket.estado === 'pendiente') Pendiente
                            option(value="en_proceso" selected=ticket.estado === 'en_proceso') En proceso
                            option(value="resuelto" selected=ticket.estado === 'resuelto') Resuelto
                            option(value="cancelado" selected=ticket.estado === 'cancelado') Cancelado

                    .form-group
                        label(for="responsable") Responsable
                        input#responsable(
                            type="text"
                            name="responsable"
                            maxlength="150"
                            value=ticket.responsable || ''
                        )

                    .form-group
                        label(for="observaciones") Observaciones de soporte
                        textarea#observaciones(
                            name="observaciones"
                            rows="5"
                            maxlength="5000"
                        )= ticket.observaciones || ''

                    .form-actions
                        button.btn.btn-primary(type="submit")
                            i.fa-solid.fa-floppy-disk
                            |  Guardar cambios

                        a.btn.btn-secondary(href=dashboardUrl + '/' + ticket.id)
                            | Cancelar

            else
                .detail-item
                    strong Título:
                    span= ticket.titulo

                .detail-item
                    strong Descripción:
                    p.descripcion= ticket.descripcion

                .detail-item
                    strong Categoría:
                    span= ticket.categoria || '—'

                .detail-item
                    strong Prioridad:
                    span= ticket.prioridad || '—'

                .detail-item
                    strong Estado:
                    span= ticket.estado || '—'

                .detail-item
                    strong Responsable:
                    span= ticket.responsable || 'Sin asignar'

                .detail-item
                    strong Observaciones:
                    p.descripcion= ticket.observaciones || 'Sin observaciones'

                a.btn.btn-primary(href=dashboardUrl + '/' + ticket.id + '?editar=1')
                    i.fa-solid.fa-pen-to-square
                    |  Editar ticket

                form(
                    method="POST"
                    action=dashboardUrl + '/' + ticket.id + '/eliminar'
                    onsubmit="return confirm('¿Estás seguro de eliminar este ticket?');"
                )
                    button.btn.btn-danger(type="submit")
                        i.fa-solid.fa-trash
                        |  Eliminar ticket
