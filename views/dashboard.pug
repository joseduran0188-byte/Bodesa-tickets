
extends layout

block content
  .page-header
    div
      h2 Dashboard de Solicitudes
      p.help-text Administración y seguimiento de solicitudes del departamento de TI.

    a.btn.btn-primary(href="/tickets/nuevo")
      i.fa-solid.fa-plus
      |  Nueva Solicitud

  if !tickets || tickets.length === 0
    .empty-state
      i.fa-solid.fa-inbox
      h3 No hay solicitudes registradas
      p Todavía no existen solicitudes en el sistema.

      a.btn.btn-primary(href="/tickets/nuevo")
        i.fa-solid.fa-plus
        |  Crear la primera solicitud

  else
    .tickets-table-wrapper
      table.tickets-table
        thead
          tr
            th Prioridad
            th Título
            th Estado
            th Solicitante
            th Técnico
            th Fecha de creación
            th.actions-heading Acciones

        tbody
          each ticket in tickets
            tr
              //- Prioridad
              td
                span(class='badge badge-' + (ticket.prioridad || ''))
                  = ticket.prioridad || 'Sin prioridad'

              //- Título
              td.ticket-title
                strong= ticket.titulo || 'Sin título'

              //- Estado
              td
                span(class='badge badge-estado-' + (ticket.estado || ''))
                  = ticket.estado || 'Sin estado'

              //- Solicitante
              td
                if ticket.solicitante && ticket.solicitante.full_name
                  = ticket.solicitante.full_name
                else
                  | —

              //- Técnico
              td
                if ticket.tecnico && ticket.tecnico.full_name
                  = ticket.tecnico.full_name
                else
                  | Sin asignar

              //- Fecha de creación (horario de Colima, México)
              td.ticket-date
                if ticket.fecha_creacion
                  = new Date(ticket.fecha_creacion).toLocaleString('es-MX', { timeZone: 'America/Mexico_City', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true })
                else
                  | —

              //- Acciones
              td.actions
                .action-buttons

                  //- Ver solicitud
                  a.action-btn.action-view(
                    href='/tickets/' + ticket.id
                    title="Ver solicitud"
                    aria-label="Ver solicitud"
                  )
                    i.fa-solid.fa-eye
                    span Ver

                  //- Editar descripción
                  a.action-btn.action-edit(
                    href='/tickets/' + ticket.id + '?editar=1#editar-descripcion'
                    title="Editar descripción"
                    aria-label="Editar descripción"
                  )
                    i.fa-solid.fa-pen-to-square
                    span Editar

                  //- Eliminar: solamente administrador
                  if user && user.role === 'admin'
                    form.action-form(
                      method="POST"
                      action='/tickets/' + ticket.id + '/eliminar'
                      onsubmit="return confirm('¿Estás seguro de eliminar esta solicitud? Esta acción no se puede deshacer.');"
                    )
                      button.action-btn.action-delete(
                        type="submit"
                        title="Eliminar solicitud"
                        aria-label="Eliminar solicitud"
                      )
                        i.fa-solid.fa-trash
                        span Eliminar
