
extends layout

block content
    .container
        .page-header
            div
                h1 Panel de tickets
                p Bienvenido, #{user.full_name || user.email}

                p
                    strong Tipo de cuenta:
                    if user.role === 'admin'
                        |  Administrador
                    else if user.role === 'tecnico'
                        |  Técnico de TI
                    else
                        |  Usuario

            a.btn.btn-primary(href='/tickets/nuevo') + Nuevo ticket

        if tickets && tickets.length
            .table-responsive
                table.table
                    thead
                        tr
                            th Folio
                            th Solicitud
                            th Solicitante
                            th Prioridad
                            th Estado
                            th Responsable
                            th Fecha
                            th Acciones

                    tbody
                        each ticket in tickets
                            tr
                                td= ticket.id
                                td= ticket.titulo
                                td= ticket.nombre_solicitante || 'Sin nombre registrado'

                                td
                                    span(class='priority priority-' + (ticket.prioridad || 'media'))
                                        = ticket.prioridad || 'Media'

                                td
                                    span(class='status status-' + (ticket.estado || 'pendiente'))
                                        = ticket.estado || 'Pendiente'

                                td= ticket.responsable || 'Sin asignar'

                                td= ticket.created_at ? new Date(ticket.created_at).toLocaleDateString('es-MX') : '—'

                                td
                                    a.btn.btn-small(href='/tickets/' + ticket.id) Ver

                                    if user.role === 'admin'
                                        form(
                                            action='/tickets/' + ticket.id + '/eliminar'
                                            method='POST'
                                            onsubmit="return confirm('¿Seguro que deseas eliminar este ticket?');"
                                        )
                                            button.btn.btn-danger.btn-small(type='submit')
                                                | Eliminar

        else
            .empty-state
                h3 No hay tickets registrados
                p Cuando registres una solicitud, aparecerá aquí.
                a.btn.btn-primary(href='/tickets/nuevo') Crear primer ticket
