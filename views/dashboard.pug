
extends layout

block content
  .page-header
    h2 Dashboard de Solicitudes
    a.btn.btn-primary(href="/tickets/nuevo")
      i.fa-solid.fa-plus
      |  Nueva Solicitud

  if !tickets || tickets.length === 0
    .empty-state
      p No hay solicitudes registradas.
      a.btn.btn-primary(href="/tickets/nuevo") Crear la primera

  else
    .tickets-table-wrapper
      table.tickets-table
        thead
          tr
            th Prioridad
            th Título
            th Estado
            th Solicitante
            th Técnico
            th Fecha creación
            th Acciones

        tbody
          each ticket in tickets
            tr
              td
                span(class=`badge badge-${ticket.prioridad}`)
                  = ticket.prioridad

              td= ticket.titulo

              td
                span(class=`badge badge-estado-${ticket.estado}`)
                  = ticket.estado

              td= ticket.solicitante
                ? ticket.solicitante.full_name
                : '—'

              td= ticket.tecnico
                ? ticket.tecnico.full_name
                : 'Sin asignar'

              td= new Date(ticket.fecha_creacion).toLocaleString('es-MX')

              //- ACCIONES
              td.actions
                //- Ver solicitud
                a.action-btn(
                  href=`/tickets/${ticket.id}`
                  title="Ver solicitud"
                  aria-label="Ver solicitud"
                )
                  i.fa-solid.fa-eye

                //- Editar descripción
                a.action-btn(
                  href=`/tickets/${ticket.id}#editar-descripcion`
                  title="Editar descripción"
                  aria-label="Editar descripción"
                )
                  i.fa-solid.fa-pen-to-square

                //- Eliminar: exclusivamente administrador
                if user.role === 'admin'
                  form(
                    method="POST"
                    action=`/tickets/${ticket.id}/eliminar`
                    onsubmit="return confirm('¿Estás seguro de eliminar esta solicitud? Esta acción no se puede deshacer.');"
                  )
                    button.action-btn.action-delete(
                      type="submit"
                      title="Eliminar solicitud"
                      aria-label="Eliminar solicitud"
                    )
                      i.fa-solid.fa-trash
