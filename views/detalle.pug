
extends layout

block content
  .page-header
    h2= ticket.titulo
    a.btn.btn-secondary(href="/tickets")
      i.fa-solid.fa-arrow-left
      |  Volver

  .detail-grid

    //- INFORMACIÓN DE LA SOLICITUD
    .detail-card
      h3 Información de la solicitud

      .detail-item
        strong Estado:
        span(class=`badge badge-estado-${ticket.estado}`)
          = ticket.estado

      .detail-item
        strong Prioridad:
        span(class=`badge badge-${ticket.prioridad}`)
          = ticket.prioridad

      .detail-item
        strong Categoría:
        span= ticket.categoria || '—'

      .detail-item
        strong Solicitante:
        span= ticket.solicitante
          ? ticket.solicitante.full_name
          : '—'

      .detail-item
        strong Correo:
        span= ticket.solicitante
          ? ticket.solicitante.email
          : '—'

      .detail-item
        strong Técnico asignado:
        span= ticket.tecnico
          ? ticket.tecnico.full_name
          : 'Sin asignar'

                  .detail-item
                strong Fecha de creación:
                span= ticket.created_at ? new Date(ticket.created_at).toLocaleString('es-MX', { timeZone: 'America/Mexico_City', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23' }) : '—'

            .detail-item
                strong Fecha de atención:
                span= ticket.fecha_atencion ? new Date(ticket.fecha_atencion).toLocaleString('es-MX', { timeZone: 'America/Mexico_City', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23' }) : 'Pendiente'

            .detail-item
                strong Fecha de resolución:
                span= ticket.fecha_resolucion ? new Date(ticket.fecha_resolucion).toLocaleString('es-MX', { timeZone: 'America/Mexico_City', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23' }) : 'Pendiente'

    //- DESCRIPCIÓN
    .detail-card
      h3 Descripción

      p.descripcion= ticket.descripcion

      //- Propietario, administrador o técnico pueden editar.
      if ticket.solicitante_id === user.id || ['admin', 'tecnico'].includes(user.role)

        details#editar-descripcion.edit-description(
          open=editarDescripcion
        )
          summary.btn.btn-secondary
            i.fa-solid.fa-pen-to-square
            |  Editar descripción

          form(
            method="POST"
            action=`/tickets/${ticket.id}/editar-descripcion`
          )
            .form-group
              label(for="descripcion") Nueva descripción

              textarea#descripcion(
                name="descripcion"
                rows="6"
                maxlength="5000"
                required
              )= ticket.descripcion

              small.help-text
                | Máximo 5000 caracteres.

            .form-actions
              button.btn.btn-primary(type="submit")
                i.fa-solid.fa-floppy-disk
                |  Guardar descripción

      if ticket.observaciones
        .observations-section
          h4 Observaciones / Notas del técnico
          p.descripcion= ticket.observaciones

  //- ACTUALIZACIÓN PARA ADMINISTRADORES Y TÉCNICOS
  if user.role === 'admin' || user.role === 'tecnico'

    .form-card
      h3 Actualizar ticket

      form(
        method="POST"
        action=`/tickets/${ticket.id}/actualizar`
      )

        .form-row
          .form-group
            label(for="estado") Estado

            select#estado(name="estado" required)
              option(
                value="pendiente"
                selected=ticket.estado === 'pendiente'
              ) Pendiente

              option(
                value="en_proceso"
                selected=ticket.estado === 'en_proceso'
              ) En proceso

              option(
                value="resuelto"
                selected=ticket.estado === 'resuelto'
              ) Resuelto

              option(
                value="cerrado"
                selected=ticket.estado === 'cerrado'
              ) Cerrado

          .form-group
            label(for="prioridad") Prioridad

            select#prioridad(name="prioridad" required)
              option(
                value="baja"
                selected=ticket.prioridad === 'baja'
              ) Baja

              option(
                value="media"
                selected=ticket.prioridad === 'media'
              ) Media

              option(
                value="alta"
                selected=ticket.prioridad === 'alta'
              ) Alta

        .form-group
          label(for="observaciones")
            | Observaciones / Notas del técnico

          textarea#observaciones(
            name="observaciones"
            rows="4"
          )= ticket.observaciones || ''

        .form-actions
          button.btn.btn-primary(type="submit")
            i.fa-solid.fa-floppy-disk
            |  Guardar cambios
