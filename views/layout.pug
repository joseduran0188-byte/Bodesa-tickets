
doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")

        title Bodesa TI - Gestión de Solicitudes

        //- Hoja de estilos del proyecto
        link(rel="stylesheet" href="/css/style.css")

        //- Biblioteca de iconos Font Awesome
        link(
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
            referrerpolicy="no-referrer"
        )

    body
        if user
            header.header
                .container
                    .logo
                        h1 Bodesa TI
                        span Sistema de Solicitudes

                    nav
                        a(href="/tickets")
                            i.fa-solid.fa-house
                            |  Dashboard

                        if user.role === 'admin' || user.role === 'tecnico'
                            a(href="/export/excel")
                                i.fa-solid.fa-file-excel
                                |  Exportar Excel

                        a(href="/tickets/nuevo")
                            i.fa-solid.fa-plus
                            |  Nueva Solicitud

                        .user-info
                            span #{user.full_name || user.email}
                            span.role (#{user.role})

                            //- Cierre de sesión mediante POST
                            form(action="/logout" method="POST")
                                button.btn-logout(type="submit")
                                    i.fa-solid.fa-right-from-bracket
                                    |  Salir

        main.container
            block content

        footer
            .container
                p Sistema de Gestión de Tickets - Departamento de TI · Bodesa
