
doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        meta(name="referrer" content="no-referrer")

        title= title || 'Bodesa TI - Gestión de Solicitudes'

        //- Hoja de estilos del proyecto
        link(rel="stylesheet" href="/css/style.css")

        //- Biblioteca de iconos Font Awesome
        link(
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
            referrerpolicy="no-referrer"
        )

    body
        if user
            header.header
                .container
                    .logo
                        h1 Bodesa TI
                        span Sistema de Solicitudes

                    nav
                        //- Dashboard
                        a(href=dashboardUrl)
                            i.fa-solid.fa-house
                            |  Dashboard

                        //- Nueva solicitud para usuarios
                        if user.role === 'user'
                            a(href=nuevoTicketUrl)
                                i.fa-solid.fa-plus
                                |  Nueva Solicitud

                        //- Módulo de actividades para administradores y técnicos
                        if user.role === 'admin' || user.role === 'tecnico'
                            a(href=`/sesion/${sessionToken}/actividades`)
                                i.fa-solid.fa-inbox
                                |  Capturas

                            //- Tablero Kanban
                            a(href=`/sesion/${sessionToken}/actividades/tablero`)
                                i.fa-solid.fa-table-columns
                                |  Tablero

                            //- Actividades asignadas al colaborador
                            a(href=`/sesion/${sessionToken}/actividades/mi-trabajo`)
                                i.fa-solid.fa-briefcase
                                |  Mi trabajo

                            //- Métricas de productividad
                            a(href=`/sesion/${sessionToken}/actividades/metricas`)
                                i.fa-solid.fa-chart-line
                                |  Métricas

                        //- Exportar Excel para administrador y técnico
                        if user.role === 'admin' || user.role === 'tecnico'
                            a(href=dashboardUrl + '/exportar/excel')
                                i.fa-solid.fa-file-excel
                                |  Exportar Excel

                        //- Información del usuario
                        .user-info
                            span #{user.full_name || user.email}
                            span.role (#{user.role})

                            //- Cierre de sesión únicamente de esta pestaña
                            form(action=logoutUrl method="POST")
                                button.btn-logout(type="submit")
                                    i.fa-solid.fa-right-from-bracket
                                    |  Salir

        //- Contenido principal
        main.container
            block content

        //- Pie de página
        footer
            .container
                p Sistema de Gestión de Tickets - Departamento de TI · Bodesa
