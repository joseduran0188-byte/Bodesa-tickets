doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Bodesa TI - Gestión de Solicitudes
    link(rel="stylesheet" href="/css/style.css")
  body
    if user
      header.header
        .container
          .logo
            h1 Bodesa TI
            span Sistema de Solicitudes
          nav
            a(href="/tickets") Dashboard
            if user.role === 'admin' || user.role === 'tecnico'
              a(href="/export/excel") Exportar Excel
            a(href="/tickets/nuevo") Nueva Solicitud
            .user-info
              span #{user.full_name || user.email}
              span.role (#{user.role})
              a.btn-logout(href="/logout") Salir

    main.container
      block content

    footer
      .container
        p Sistema de Gestión de Tickets - Departamento de TI · Bodesa