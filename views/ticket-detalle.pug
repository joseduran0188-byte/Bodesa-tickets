
extends layout

block content
    .container
        .page-header
            div
                h1 Detalle del ticket
                p Folio: #{ticket.id}

            a.btn.btn-secondary(href='/tickets') Volver al panel

        .detail-card
            .detail-grid

                .detail-item
                    strong Solicitud:
                    span= ticket.titulo

                .detail-item
                    strong Solicitante:
                    span= ticket.nombre_solicitante || 'Sin nombre registrado'

                .detail-item
                    strong Correo de la cuenta:
                    span= ticket.solicitante ? ticket.solicitante.email : 'No disponible'

                .detail-item
                    strong Categoría:
                    span= ticket.categoria || 'General'

                .detail-item
                    strong Prioridad:
                    span= ticket.prioridad || 'Media'

                .detail-item
                    strong Estado:
                    span= ticket.estado || 'Pendiente'

                .detail-item
                    strong Responsable:
                    span= ticket.responsable || 'Sin asignar'

                .detail-item
                    strong Fecha de creación:
                    span= ticket.created_at ? new Date(ticket.created_at).toLocaleString('es-MX') : '—'

                .detail-item
                    strong Fecha de atención:
                    span= ticket.fecha_atencion ? new Date(ticket.fecha_atencion).toLocaleString('es-MX') : 'Pendiente'

                .detail-item
                    strong Fecha de resolución:
                    span= ticket.fecha_resolucion ? new Date(ticket.fecha_resolucion).toLocaleString('es-MX') : 'Pendiente'

            .detail-item.full-width
                strong Descripción:
                p= ticket.descripcion

            .detail-item.full-width
                strong Observaciones:
                p= ticket.observaciones || 'Sin observaciones.'

        //- Edición de descripción para propietario, técnico o administrador
        if user && (user.role === 'admin' || user.role === 'tecnico' || ticket.solicitante_id === user.id)

            .section-card
                h2 Editar descripción

                if editarDescripcion
                    form(
                        action='/tickets/' + ticket.id + '/editar-descripcion'
                        method='POST'
                    )
                        .form-group
                            label(for='descripcion') Descripción

                            textarea#descripcion(
                                name='descripcion'
                                rows='5'
                                required
                            )= ticket.descripcion

                        button.btn.btn-primary(type='submit')
                            | Guardar descripción

                        a.btn.btn-secondary(href='/tickets/' + ticket.id)
                            | Cancelar

                else
                    a.btn.btn-secondary(
                        href='/tickets/' + ticket.id + '?editar=1'
                    )
                        | Editar descripción

        //- Gestión exclusiva de administrador y técnico
        if user && ['admin', 'tecnico'].includes(user.role)

            .section-card
                h2 Gestión del ticket

                form(
                    action='/tickets/' + ticket.id + '/actualizar'
                    method='POST'
                )
                    .form-group
                        label(for='estado') Estado

                        select#estado(name='estado' required)
                            option(
                                value='pendiente'
                                selected=ticket.estado === 'pendiente'
                            ) Pendiente

                            option(
                                value='en_proceso'
                                selected=ticket.estado === 'en_proceso'
                            ) En proceso

                            option(
                                value='resuelto'
                                selected=ticket.estado === 'resuelto'
                            ) Resuelto

                            option(
                                value='cancelado'
                                selected=ticket.estado === 'cancelado'
                            ) Cancelado

                    .form-group
                        label(for='prioridad') Prioridad

                        select#prioridad(name='prioridad' required)
                            option(
                                value='baja'
                                selected=ticket.prioridad === 'baja'
                            ) Baja

                            option(
                                value='media'
                                selected=ticket.prioridad === 'media'
                            ) Media

                            option(
                                value='alta'
                                selected=ticket.prioridad === 'alta'
                            ) Alta

                            option(
                                value='urgente'
                                selected=ticket.prioridad === 'urgente'
                            ) Urgente

                    .form-group
                        label(for='responsable') Responsable de atención

                        input#responsable(
                            type='text'
                            name='responsable'
                            maxlength='150'
                            value=ticket.responsable || ''
                            placeholder='Nombre de quien atenderá la solicitud'
                        )

                    .form-group
                        label(for='observaciones') Observaciones

                        textarea#observaciones(
                            name='observaciones'
                            rows='4'
                            placeholder='Agrega comentarios sobre la atención...'
                        )= ticket.observaciones || ''

                    button.btn.btn-primary(type='submit')
                        | Guardar cambios
