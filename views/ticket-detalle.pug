
extends layout

block content
  .page-header
    h2= `Ticket #${ticket.id}`
    a.btn.btn-secondary(href="/tickets")
      i.fa-solid.fa-arrow-left
      |  Volver

  .detail-grid

    //- INFORMACIÓN DE LA SOLICITUD
    .detail-card
      h3 Información de la solicitud

      .detail-item
        strong Estado:
        span(class=`badge badge-estado-${ticket.estado}`)
          = ticket.estado

      .detail-item
        strong Prioridad:
        span(class=`badge badge-${ticket.prioridad}`)
          = ticket.prioridad

      .detail-item
        strong Categoría:
        span= ticket.categoria || '—'

      .detail-item
        strong Nombre del solicitante:
        span= ticket.nombre_solicitante || '—'

      .detail-item
        strong Correo de la cuenta:
        span= ticket.solicitante ? ticket.solicitante.email : '—'

      .detail-item
        strong Responsable:
        span= ticket.responsable || 'Sin asignar'

            .detail-item
                strong Fecha de creación:
                span= ticket.created_at ? new Date(ticket.created_at).toLocaleString('es-MX', { timeZone: 'America/Mexico_City', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true }) : '—'

            .detail-item
                strong Fecha de atención:
                span= ticket.created_at ? new Date(ticket.created_at).toLocaleString('es-MX', { timeZone: 'America/Mexico_City', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true }) : 'Pendiente'

            .detail-item
                strong Fecha de resolución:
                span= ticket.created_at ? new Date(ticket.created_at).toLocaleString('es-MX', { timeZone: 'America/Mexico_City', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true }) : 'Pendiente'
            .detail-item
                strong Última actualización:
                span= formatearFecha(ticket.updated_at)
    //- DESCRIPCIÓN
    .detail-card
      h3 Descripción
      p.descripcion= ticket.descripcion

      if ticket.observaciones
        .observations-section
          h4 Observaciones / Notas del técnico
          p.descripcion= ticket.observaciones

  //- FORMULARIO DE EDICIÓN COMPLETA
  if ticket.solicitante_id === user.id || ['admin', 'tecnico'].includes(user.role)

    .form-card
      h3= editarTicket ? 'Editar información del ticket' : 'Acciones del ticket'

      if !editarTicket
        a.btn.btn-secondary(href=`/tickets/${ticket.id}?editar=1`)
          i.fa-solid.fa-pen-to-square
          |  Editar ticket

      else
        form(
          method="POST"
          action=`/tickets/${ticket.id}/actualizar`
        )

          h4 Información de la solicitud

          .form-group
            label(for="nombre_solicitante") Nombre del solicitante
            input#nombre_solicitante(
              type="text"
              name="nombre_solicitante"
              maxlength="150"
              value=ticket.nombre_solicitante || ''
              required
            )

          .form-group
            label(for="titulo") Título de la solicitud
            input#titulo(
              type="text"
              name="titulo"
              maxlength="200"
              value=ticket.titulo
              required
            )

          .form-group
            label(for="descripcion") Descripción
            textarea#descripcion(
              name="descripcion"
              rows="6"
              maxlength="5000"
              required
            )= ticket.descripcion

          .form-group
            label(for="categoria") Categoría
            select#categoria(name="categoria" required)
              option(value="general" selected=ticket.categoria === 'general') General
              option(value="software" selected=ticket.categoria === 'software') Software
              option(value="hardware" selected=ticket.categoria === 'hardware') Hardware
              option(value="redes" selected=ticket.categoria === 'redes') Redes
              option(value="sistemas" selected=ticket.categoria === 'sistemas') Sistemas
              option(value="accesos" selected=ticket.categoria === 'accesos') Accesos
              option(value="otro" selected=ticket.categoria === 'otro') Otro

          //- CAMPOS EXCLUSIVOS DE ADMINISTRADOR Y TÉCNICO
          if ['admin', 'tecnico'].includes(user.role)

            h4 Gestión del ticket

            .form-row
              .form-group
                label(for="estado") Estado
                select#estado(name="estado" required)
                  option(value="pendiente" selected=ticket.estado === 'pendiente') Pendiente
                  option(value="en_proceso" selected=ticket.estado === 'en_proceso') En proceso
                  option(value="resuelto" selected=ticket.estado === 'resuelto') Resuelto
                  option(value="cancelado" selected=ticket.estado === 'cancelado') Cancelado
                  option(value="cerrado" selected=ticket.estado === 'cerrado') Cerrado

              .form-group
                label(for="prioridad") Prioridad
                select#prioridad(name="prioridad" required)
                  option(value="baja" selected=ticket.prioridad === 'baja') Baja
                  option(value="media" selected=ticket.prioridad === 'media') Media
                  option(value="alta" selected=ticket.prioridad === 'alta') Alta
                  option(value="urgente" selected=ticket.prioridad === 'urgente') Urgente

            .form-group
              label(for="responsable") Responsable asignado
              input#responsable(
                type="text"
                name="responsable"
                maxlength="150"
                value=ticket.responsable || ''
                placeholder="Nombre del responsable"
              )

            .form-group
              label(for="observaciones") Observaciones / Notas del técnico
              textarea#observaciones(
                name="observaciones"
                rows="4"
                maxlength="5000"
              )= ticket.observaciones || ''

          .form-actions
            button.btn.btn-primary(type="submit")
              i.fa-solid.fa-floppy-disk
              |  Guardar cambios

            a.btn.btn-secondary(href=`/tickets/${ticket.id}`)
              i.fa-solid.fa-xmark
              |  Cancelar
