
extends ../layout

block content
    .container
        .page-header
            div
                h1 Panel de soporte técnico
                p Bienvenido, #{user.full_name || user.email}

                p
                    strong Tipo de cuenta:
                    |  Técnico de TI

        if tickets && tickets.length
            .tickets-table-wrapper
                table.tickets-table
                    thead
                        tr
                            th Folio
                            th Solicitud
                            th Solicitante
                            th Prioridad
                            th Estado
                            th Responsable
                            th Fecha
                            th.actions-heading Acciones

                    tbody
                        each ticket in tickets
                            tr
                                td= ticket.id
                                td.ticket-title= ticket.titulo
                                td= ticket.nombre_solicitante || 'Sin nombre registrado'

                                td
                                    - const prioridad = (ticket.prioridad || 'media').toLowerCase()
                                    - const prioridadClase = prioridad === 'urgente' ? 'alta' : prioridad
                                    span(class='badge badge-' + prioridadClase)
                                        = prioridad.charAt(0).toUpperCase() + prioridad.slice(1)

                                td
                                    - const estado = (ticket.estado || 'pendiente').toLowerCase()
                                    - const estadoClase = estado === 'cancelado' ? 'cerrado' : estado
                                    span(class='badge badge-estado-' + estadoClase)
                                        = estado === 'en_proceso' ? 'En proceso' : estado.charAt(0).toUpperCase() + estado.slice(1)

                                td.responsable-column
                                    = ticket.responsable || 'Sin asignar'

                                td.ticket-date
                                    = ticket.created_at ? new Date(ticket.created_at).toLocaleDateString('es-MX') : '—'

                                td.actions
                                    .action-buttons
                                        a.action-btn.action-view(
                                            href=dashboardUrl + '/' + ticket.id
                                            title='Ver ticket'
                                        )
                                            i.fa-solid.fa-eye
                                            span Ver

                                        a.action-btn.action-edit(
                                            href=dashboardUrl + '/' + ticket.id + '?editar=1'
                                            title='Atender ticket'
                                        )
                                            i.fa-solid.fa-pen-to-square
                                            span Atender

        else
            .empty-state
                i.fa-solid.fa-clipboard-list
                h3 No hay tickets registrados
                p Cuando se registren solicitudes, aparecerán aquí.
